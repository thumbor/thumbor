# NSXBet Thumbor image — fork of upstream docker/Dockerfile
# Differences: installs thumbor from PyPI + thumbor-video-engine,
# adds ffmpeg, ships NSX config, plain CMD (no build_ext of source tree).
ARG PYTHON_VERSION=3.12
FROM python:${PYTHON_VERSION}-slim-trixie

ARG DEBIAN_FRONTEND=noninteractive

RUN apt-get update && \
    apt-get install --no-install-recommends -y \
        ffmpeg \
        gifsicle \
        curl \
        libjpeg62-turbo \
        libwebp7 && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir \
    "thumbor[all]==7.8.0" \
    "thumbor-video-engine==1.3.1"

COPY conf/thumbor.conf /etc/thumbor/thumbor.conf

RUN useradd --create-home thumbor && chown -R thumbor /etc/thumbor
USER thumbor

EXPOSE 8888

ENV PYTHONUNBUFFERED=1

HEALTHCHECK --interval=10s --timeout=5s --start-period=15s --retries=3 \
    CMD curl -fsS http://localhost:8888/healthcheck || exit 1

CMD ["thumbor", "-c", "/etc/thumbor/thumbor.conf", "-p", "8888", "-l", "info"]
